{
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "allowJs": true,
    "checkJs": false,
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    "jsx": "react-jsx",
    "target": "ESNext",
    "ignoreDeprecations": "6.0",
    "baseUrl": "./"
  },
  "include": [
    "./**/*",
    "src/**/*",
    "global.d.ts"
  ],
  "exclude": [
    "./plugins/**/*",
    "./typings/**/*",
    "./dist/**/*" 
  ]
}